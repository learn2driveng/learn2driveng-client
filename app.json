{
  "expo": {
    "name": "learn2driveng",
    "slug": "learn2driveng",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "learn2driveng",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.learn2drive.ng",
      "infoPlist": {
        "UIBackgroundModes": ["location", "remote-notification"]
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.learn2drive.ng"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Learn2Drive to use your location for nearby schools and to share the instructor's location during active lessons.",
          "locationAlwaysAndWhenInUsePermission": "Allow Learn2Drive to continue sharing lesson GPS while the app is in the background during an active session.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Learn2Drive to access photos so you can upload school logos and instructor passport photographs.",
          "cameraPermission": "Allow Learn2Drive to use the camera so you can take school logo photos and instructor passport photographs.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f1f2f4",
          "android": {
            "image": "./assets/images/logo-light.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.184228687578-0396525e7llg78ebhkv665996cfk6ib8"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FFB800",
          "defaultChannel": "updates-v2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b381c9a-4fee-45a7-b5ef-3fdaa534f29f"
      }
    },
    "owner": "learn2driveng-org"
  }
}
