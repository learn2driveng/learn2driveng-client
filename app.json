{
  "expo": {
    "name": "learn2driveng",
    "slug": "learn2driveng",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "learn2driveng",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.learn2drive.ng"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.learn2drive.ng"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Learn2Drive to use your location for nearby schools and learner-approved sharing during active lessons."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f1f2f4",
          "android": {
            "image": "./assets/images/logo-light.png",
            "imageWidth": 76
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b381c9a-4fee-45a7-b5ef-3fdaa534f29f"
      }
    },
    "owner": "learn2driveng-org"
  }
}
