# Learn2Drive API
EXPO_PUBLIC_API_URL=http://localhost:7777/api/v1
EXPO_PUBLIC_WEB_APP_URL=https://learn2drive.ng
EXPO_PUBLIC_SOCKET_URL=https://api.learn2drive.ng

# Maps — any of these work (same Google Cloud key is fine):
# GOOGLE_MAPS_API_KEY matches the server variable name
# EXPO_PUBLIC_* vars are also supported directly in the client bundle
GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=

# Environment
EXPO_PUBLIC_APP_ENV=development
